# Copy to .env and fill in real values. Never commit the real .env file.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Public half of the Web Push VAPID key pair (safe to expose to the client —
# the private half lives only as a Supabase Edge Function secret). Generate
# a pair with: npx web-push generate-vapid-keys
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
